# Debug mode: if true, saves images to debug_output/ instead of driving the panel
DEBUG=false

# MTA Subway configuration
# Station ID for train arrivals (e.g., "F19S" for a specific station)
STATION_ID=your_station_id

# Train lines to monitor (e.g., "F", "G")
TRAIN_LINE_1=F
TRAIN_LINE_2=G

# Weather configuration (optional - defaults to NYC coordinates)
# Open-Meteo API is used - no API key required!
WEATHER_LAT=40.7128
WEATHER_LON=-74.0060

# Quiet mode: if true, suppresses console output
QUIET_MODE=false

# Feed and display timing
WEATHER_UPDATE_SECONDS=300
SUBWAY_UPDATE_SECONDS=5
CITIBIKE_UPDATE_SECONDS=60
BIRD_UPDATE_SECONDS=900
DISPLAY_MIN_INTERVAL_SECONDS=1
DISPLAY_CLEAR_COOLDOWN_SECONDS=5

# Citi Bike configuration
# Find your station's UUID + name in the GBFS feed:
# https://gbfs.citibikenyc.com/gbfs/en/station_information.json
CITIBIKE_STATION_ID=your_citibike_station_uuid
CITIBIKE_STATION_NAME=Your Station Name

# BirdNET-Pi configuration
# The display Pi runs this SSH command against the BirdNET-Pi sensor host:
# ssh birdnet 'sqlite3 -json ~/BirdNET-Pi/scripts/birds.db "..."'
BIRDNET_SSH_HOST=birdnet
BIRDNET_DB_PATH=~/BirdNET-Pi/scripts/birds.db
BIRD_WINDOW_HOURS=24
BIRD_RESULT_LIMIT=15
BIRD_ASSET_DIR=assets/birds/illustrations
BIRD_MOCK_DATA=assets/birds/mock_detections.json
BIRD_USE_MOCK_DATA=false

# Panel output
# DISPLAY_DEVICE is the framebuffer the DSI overlay creates.
# DISPLAY_ROTATION (0/90/180/270) compensates for how the panel is mounted.
DISPLAY_DEVICE=/dev/fb0
DISPLAY_ROTATION=0

# Backlight (0-100). Tapping the touchscreen toggles the panel on and off.
BACKLIGHT_BRIGHTNESS=100
# Optional night dimming; leave the times empty to disable.
BACKLIGHT_NIGHT_BRIGHTNESS=25
BACKLIGHT_NIGHT_START=
BACKLIGHT_NIGHT_END=

# Touchscreen. Leave TOUCH_DEVICE empty to auto-detect the evdev node.
TOUCH_ENABLED=true
TOUCH_DEVICE=
